---
import "../styles/global.css";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
	title: string;
	description?: string;
	lang?: string;
}

const {
	title,
	description = "Restaurarea parchetului în Moldova. Cicluire, lăcuire, reparație.",
	lang = "ru",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=1" />
		<link rel="apple-touch-icon" href="/favicon.svg?v=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		{/* SEO & Multilingual */}
		<link
			rel="canonical"
			href={`https://parchetmaster.vercel.app${Astro.url.pathname}`}
		/>
		<link
			rel="alternate"
			hreflang="ru"
			href={`https://parchetmaster.vercel.app${Astro.url.pathname.replace(/^\/ro/, "")}`}
		/>
		<link
			rel="alternate"
			hreflang="ro"
			href={`https://parchetmaster.vercel.app/ro${Astro.url.pathname.replace(/^\/ro/, "")}`}
		/>
		<link
			rel="alternate"
			hreflang="x-default"
			href={`https://parchetmaster.vercel.app${Astro.url.pathname.replace(/^\/ro/, "")}`}
		/>

		{/* Open Graph / Facebook */}
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta
			property="og:image"
			content="https://parchetmaster.vercel.app/parquet_header.webp"
		/>

		{/* Twitter */}
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta
			property="twitter:image"
			content="https://parchetmaster.vercel.app/parquet_header.webp"
		/>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Lora:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body
		class="font-sans antialiased text-stone-900 bg-[#fdfcfb] relative selection:bg-amber-200"
	>
		{/* Global Grain Texture Overlay */}
		<div
			class="fixed inset-0 pointer-events-none opacity-[0.03] z-[9999] bg-[url('https://www.transparenttextures.com/patterns/dark-matter.png')]"
		>
		</div>
		<slot />
		<SpeedInsights />
	</body>
</html>
