---
import LandingPage from "../components/LandingPage.astro";
import { createReader } from "@keystatic/core/reader";
import config from "../../keystatic.config";

const reader = createReader(process.cwd(), config);
const rawGalleryItems = await reader.collections.gallery.all();

const galleryItems = rawGalleryItems.map((item: any) => ({
  id: item.slug,
  title: item.entry.title,
  description: item.entry.description,
  beforeImage: item.entry.beforeImage,
  afterImage: item.entry.afterImage,
}));

const lang = "ru";
---

<LandingPage lang={lang} galleryItems={galleryItems} />
