---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { useTranslations } from "../i18n/ui";

// Определяем язык из URL
const path = Astro.url.pathname;
const lang = path.startsWith('/ro') ? 'ro' : 'ru';
const t = useTranslations(lang as 'ru' | 'ro');

const content = {
    ru: {
        title: '404 | Страница не найдена',
        heading: 'Упс! Страница не найдена',
        text: 'Похоже, вы заблудились в нашем паркетном лесу. Страница, которую вы ищете, не существует или была перемещена.',
        home: '🏠 На главную',
        blog: '📖 Читать блог',
        maybe: 'Возможно, вы искали:',
    },
    ro: {
        title: '404 | Pagina nu a fost găsită',
        heading: 'Pagina nu a fost găsită',
        text: 'Se pare că v-ați rătăcit în pădurea noastră de parchet. Pagina pe care o căutați nu există sau a fost mutată.',
        home: '🏠 Acasă',
        blog: '📖 Blog',
        maybe: 'Căutați poate:',
    },
}[lang];
---

<Layout
    title={content.title}
    description={content.text}
    lang={lang}
>
    <Header lang={lang} />

    <main>
        <section class="min-h-[70vh] flex items-center justify-center px-4 bg-gradient-to-b from-parchment to-white">
            <div class="text-center max-w-2xl">
                <!-- Паркетный узор 404 -->
                <div class="mb-8 relative">
                    <div class="grid grid-cols-4 gap-2 max-w-xs mx-auto mb-8">
                        <!-- Паркетные дощечки -->
                        <div class="aspect-square bg-[#8B6F47] rounded-lg shadow-inner transform rotate-0"></div>
                        <div class="aspect-square bg-[#A08060] rounded-lg shadow-inner transform rotate-90"></div>
                        <div class="aspect-square bg-[#8B6F47] rounded-lg shadow-inner transform rotate-180"></div>
                        <div class="aspect-square bg-[#A08060] rounded-lg shadow-inner transform rotate-270"></div>
                        <div class="aspect-square bg-[#A08060] rounded-lg shadow-inner transform rotate-270"></div>
                        <div class="aspect-square bg-[#8B6F47] rounded-lg shadow-inner transform rotate-180"></div>
                        <div class="aspect-square bg-[#A08060] rounded-lg shadow-inner transform rotate-90"></div>
                        <div class="aspect-square bg-[#8B6F47] rounded-lg shadow-inner transform rotate-0"></div>
                        <div class="aspect-square bg-[#8B6F47] rounded-lg shadow-inner transform rotate-0"></div>
                        <div class="aspect-square bg-[#A08060] rounded-lg shadow-inner transform rotate-90"></div>
                        <div class="aspect-square bg-[#8B6F47] rounded-lg shadow-inner transform rotate-180"></div>
                        <div class="aspect-square bg-[#A08060] rounded-lg shadow-inner transform rotate-270"></div>
                        <div class="aspect-square bg-[#A08060] rounded-lg shadow-inner transform rotate-270"></div>
                        <div class="aspect-square bg-[#8B6F47] rounded-lg shadow-inner transform rotate-180"></div>
                        <div class="aspect-square bg-[#A08060] rounded-lg shadow-inner transform rotate-90"></div>
                        <div class="aspect-square bg-[#8B6F47] rounded-lg shadow-inner transform rotate-0"></div>
                    </div>
                    
                    <!-- 404 текст -->
                    <div class="absolute inset-0 flex items-center justify-center">
                        <span class="text-8xl sm:text-9xl font-bold text-white drop-shadow-lg">404</span>
                    </div>
                </div>

                <h1 class="text-3xl sm:text-4xl font-serif font-bold text-espresso mb-4">
                    {content.heading}
                </h1>
                
                <p class="text-xl text-stone-600 mb-8 leading-relaxed">
                    {content.text}
                </p>

                <div class="flex flex-col sm:flex-row justify-center gap-4">
                    <a
                        href={lang === 'ro' ? '/ro' : '/'}
                        class="bg-cognac text-white px-8 py-4 rounded-2xl font-bold hover:brightness-110 transition shadow-lg"
                    >
                        {content.home}
                    </a>
                    <a
                        href={lang === 'ro' ? '/blog/ro' : '/blog/ru'}
                        class="border-2 border-cognac text-cognac px-8 py-4 rounded-2xl font-bold hover:bg-cognac/10 transition"
                    >
                        {content.blog}
                    </a>
                </div>

                <!-- Полезные ссылки -->
                <div class="mt-12 pt-8 border-t border-stone-200">
                    <p class="text-stone-500 mb-4">{content.maybe}</p>
                    <div class="flex flex-wrap justify-center gap-3">
                        <a href="/#services" class="text-cognac hover:underline">{t("nav.services")}</a>
                        <span class="text-stone-300">•</span>
                        <a href="/#gallery" class="text-cognac hover:underline">{t("nav.gallery")}</a>
                        <span class="text-stone-300">•</span>
                        <a href="/#calculator" class="text-cognac hover:underline">{t("nav.calculator")}</a>
                        <span class="text-stone-300">•</span>
                        <a href="/#contacts" class="text-cognac hover:underline">{t("nav.contacts")}</a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <Footer lang={lang} />
</Layout>
