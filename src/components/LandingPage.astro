---
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import Calculator from "./Calculator";
import GalleryGrid from "./GalleryGrid";
import { useTranslations } from "../i18n/ui";
import InteractiveReveal from "./InteractiveReveal";

interface Props {
    lang: "ru" | "ro";
    galleryItems: any[];
}

const { lang, galleryItems } = Astro.props;
const t = useTranslations(lang);
---

<Layout
    title={lang === "ru"
        ? "Циклевка паркета в Кишиневе без пыли за 1 день | ParchetMaster"
        : "Șlefuire parchetului în Chișinău fără praf într-o zi | ParchetMaster"}
    lang={lang}
>
    <Header lang={lang} />

    <main>
        {/* HERO SECTION */}
        <section
            class="relative py-32 px-4 sm:px-6 lg:px-8 text-center text-white overflow-hidden"
        >
            <InteractiveReveal imageUrl="/parquet_header.webp" client:load />

            <div class="relative z-20 max-w-4xl mx-auto">
                <h1
                    class="text-4xl sm:text-7xl font-semibold mb-8 tracking-tight animate-fade-in-up leading-tight"
                >
                    {t("hero.title")}
                    <span class="text-cognac italic"
                        >{t("hero.title_accent")}</span
                    >
                </h1>
                <p
                    class="text-xl sm:text-2xl text-stone-200 mb-12 max-w-2xl mx-auto animate-fade-in-up delay-200 font-light"
                >
                    {t("hero.subtitle")}
                    <span class="font-semibold text-white"
                        >{t("hero.subtitle_accent")}</span
                    >
                </p>
                <div
                    class="flex flex-col sm:flex-row justify-center gap-6 animate-fade-in-up delay-400"
                >
                    <a
                        href="#calculator"
                        class="bg-cognac text-white px-10 py-5 rounded-3xl text-lg font-bold hover:brightness-110 transition shadow-2xl transform hover:scale-105"
                    >
                        {t("hero.cta_calc")}
                    </a>
                    <a
                        href="tel:+37360588967"
                        class="bg-white/10 backdrop-blur-md border border-white/20 text-white px-10 py-5 rounded-3xl text-lg font-bold hover:bg-white hover:text-espresso transition transform hover:scale-105"
                    >
                        {t("hero.cta_call")}
                    </a>
                </div>
            </div>
        </section>

        {/* FEATURES */}
        <section class="py-24 bg-parchment relative overflow-hidden">
            <div
                class="absolute inset-0 opacity-40 bg-[url('https://www.transparenttextures.com/patterns/pinstriped-suit.png')]"
            >
            </div>
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <h2
                    class="text-3xl sm:text-5xl font-serif font-bold text-espresso text-center mb-16"
                >
                    {t("features.title")}
                    <span class="text-cognac">{t("features.title_accent")}</span
                    >
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center">
                    <div
                        class="group p-8 bg-white/50 backdrop-blur-sm rounded-[2rem] border border-stone-100 hover:border-cognac/30 hover:bg-white transition-all duration-500 shadow-sm hover:shadow-xl"
                    >
                        <div
                            class="text-5xl mb-6 transform transition group-hover:scale-110"
                        >
                            🛡️
                        </div>
                        <h3 class="text-2xl font-bold mb-4 text-espresso">
                            {t("features.warranty.title")}
                        </h3>
                        <p class="text-stone-600 leading-relaxed">
                            {t("features.warranty.desc")}
                        </p>
                    </div>
                    <div
                        class="group p-8 bg-white/50 backdrop-blur-sm rounded-[2rem] border border-stone-100 hover:border-cognac/30 hover:bg-white transition-all duration-500 shadow-sm hover:shadow-xl"
                    >
                        <div
                            class="text-5xl mb-6 transform transition group-hover:scale-110"
                        >
                            🌪️
                        </div>
                        <h3 class="text-2xl font-bold mb-4 text-espresso">
                            {t("features.dust.title")}
                        </h3>
                        <p class="text-stone-600 leading-relaxed">
                            {t("features.dust.desc")}
                        </p>
                    </div>
                    <div
                        class="group p-8 bg-white/50 backdrop-blur-sm rounded-[2rem] border border-stone-100 hover:border-cognac/30 hover:bg-white transition-all duration-500 shadow-sm hover:shadow-xl"
                    >
                        <div
                            class="text-5xl mb-6 transform transition group-hover:scale-110"
                        >
                            ⏱️
                        </div>
                        <h3 class="text-2xl font-bold mb-4 text-espresso">
                            {t("features.speed.title")}
                        </h3>
                        <p class="text-stone-600 leading-relaxed">
                            {t("features.speed.desc")}
                        </p>
                    </div>
                </div>
            </div>
        </section>

        {/* SERVICES */}
        <section
            id="services"
            class="py-24 bg-[#5B3A29] relative overflow-hidden"
        >
            <div
                class="absolute inset-0 opacity-20 bg-[url('https://www.transparenttextures.com/patterns/dark-wood.png')]"
            >
            </div>
            <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <h2
                    class="text-4xl sm:text-5xl font-extrabold text-center text-white mb-16 uppercase tracking-tight"
                >
                    {t("services.title")}
                    <span class="text-cognac">{t("services.title_accent")}</span
                    >
                </h2>
                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8"
                >
                    {
                        [
                            { key: "item1" },
                            { key: "item2" },
                            { key: "item3" },
                            { key: "item4" },
                        ].map((item) => (
                            <div class="bg-walnut/40 backdrop-blur-sm p-8 rounded-[2rem] border border-white/10 hover:border-cognac/50 hover:bg-walnut/60 transition-all duration-500 group">
                                <h3 class="text-xl font-bold mb-4 text-white group-hover:text-cognac transition-colors italic">
                                    {t(`services.${item.key}.title` as any)}
                                </h3>
                                <p class="text-stone-300 text-sm leading-relaxed">
                                    {t(`services.${item.key}.desc` as any)}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        {/* CALCULATOR */}
        <section
            id="calculator"
            class="py-24 bg-parchment relative overflow-hidden"
        >
            <div
                class="absolute inset-0 opacity-40 bg-[url('https://www.transparenttextures.com/patterns/pinstriped-suit.png')]"
            >
            </div>
            <div
                class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10"
            >
                <h2
                    class="text-4xl sm:text-5xl font-serif font-bold text-stone-900 mb-8"
                >
                    {t("calc.title")}
                    <span class="text-cognac">{t("calc.title_accent")}</span>
                </h2>
                <p
                    class="text-stone-600 mb-16 max-w-2xl mx-auto text-lg italic"
                >
                    {t("calc.subtitle")}
                </p>
                <Calculator lang={lang} client:visible />
            </div>
        </section>

        {/* GALLERY SECTION */}
        <section
            id="gallery"
            class="py-24 bg-[#5B3A29] relative overflow-hidden"
        >
            <div
                class="absolute inset-0 opacity-20 bg-[url('https://www.transparenttextures.com/patterns/dark-wood.png')]"
            >
            </div>
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="text-center mb-16">
                    <h2
                        class="text-4xl sm:text-5xl font-serif font-bold text-white mb-6 uppercase tracking-widest"
                    >
                        {t("gallery.title")}
                        <span class="text-cognac"
                            >{t("gallery.title_accent")}</span
                        >
                    </h2>
                    <div class="w-24 h-1.5 bg-cognac mx-auto rounded-full">
                    </div>
                </div>
                <GalleryGrid items={galleryItems} lang={lang} client:visible />
            </div>
        </section>

        {/* FAQ SECTION */}
        <section
            id="faq"
            class="py-24 bg-parchment relative overflow-hidden"
        >
            <div
                class="absolute inset-0 opacity-40 bg-[url('https://www.transparenttextures.com/patterns/pinstriped-suit.png')]"
            >
            </div>
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="text-center mb-16">
                    <h2
                        class="text-4xl sm:text-5xl font-serif font-bold text-stone-900 mb-6"
                    >
                        {t("faq.title")}
                        <span class="text-cognac">{t("faq.title_accent")}</span>
                    </h2>
                    <div class="w-24 h-1.5 bg-cognac mx-auto rounded-full"></div>
                </div>

                <div class="space-y-6">
                    <!-- FAQ Item 1 -->
                    <details class="group bg-white rounded-2xl shadow-sm border border-stone-100 overflow-hidden">
                        <summary class="flex justify-between items-center cursor-pointer p-6 text-lg font-bold text-espresso group-hover:bg-stone-50 transition" onClick={(e) => e.stopPropagation()}>
                            {t("faq.q1")}
                            <svg class="w-6 h-6 text-cognac transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </summary>
                        <div class="px-6 pb-6 text-stone-600 leading-relaxed">
                            {t("faq.a1")}
                        </div>
                    </details>

                    <!-- FAQ Item 2 -->
                    <details class="group bg-white rounded-2xl shadow-sm border border-stone-100 overflow-hidden">
                        <summary class="flex justify-between items-center cursor-pointer p-6 text-lg font-bold text-espresso group-hover:bg-stone-50 transition" onClick={(e) => e.stopPropagation()}>
                            {t("faq.q2")}
                            <svg class="w-6 h-6 text-cognac transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </summary>
                        <div class="px-6 pb-6 text-stone-600 leading-relaxed">
                            {t("faq.a2")}
                        </div>
                    </details>

                    <!-- FAQ Item 3 -->
                    <details class="group bg-white rounded-2xl shadow-sm border border-stone-100 overflow-hidden">
                        <summary class="flex justify-between items-center cursor-pointer p-6 text-lg font-bold text-espresso group-hover:bg-stone-50 transition" onClick={(e) => e.stopPropagation()}>
                            {t("faq.q3")}
                            <svg class="w-6 h-6 text-cognac transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </summary>
                        <div class="px-6 pb-6 text-stone-600 leading-relaxed">
                            {t("faq.a3")}
                        </div>
                    </details>

                    <!-- FAQ Item 4 -->
                    <details class="group bg-white rounded-2xl shadow-sm border border-stone-100 overflow-hidden">
                        <summary class="flex justify-between items-center cursor-pointer p-6 text-lg font-bold text-espresso group-hover:bg-stone-50 transition" onClick={(e) => e.stopPropagation()}>
                            {t("faq.q4")}
                            <svg class="w-6 h-6 text-cognac transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </summary>
                        <div class="px-6 pb-6 text-stone-600 leading-relaxed">
                            {t("faq.a4")}
                        </div>
                    </details>

                    <!-- FAQ Item 5 -->
                    <details class="group bg-white rounded-2xl shadow-sm border border-stone-100 overflow-hidden">
                        <summary class="flex justify-between items-center cursor-pointer p-6 text-lg font-bold text-espresso group-hover:bg-stone-50 transition" onClick={(e) => e.stopPropagation()}>
                            {t("faq.q5")}
                            <svg class="w-6 h-6 text-cognac transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </summary>
                        <div class="px-6 pb-6 text-stone-600 leading-relaxed">
                            {t("faq.a5")}
                        </div>
                    </details>
                </div>

                {/* FAQ Structured Data */}
                <script type="application/ld+json" is:inline>
                    {
                        "@context": "https://schema.org",
                        "@type": "FAQPage",
                        "mainEntity": [
                            {
                                "@type": "Question",
                                "name": lang === 'ro' ? t("faq.q1") : t("faq.q1"),
                                "acceptedAnswer": {
                                    "@type": "Answer",
                                    "text": t("faq.a1")
                                }
                            },
                            {
                                "@type": "Question",
                                "name": t("faq.q2"),
                                "acceptedAnswer": {
                                    "@type": "Answer",
                                    "text": t("faq.a2")
                                }
                            },
                            {
                                "@type": "Question",
                                "name": t("faq.q3"),
                                "acceptedAnswer": {
                                    "@type": "Answer",
                                    "text": t("faq.a3")
                                }
                            },
                            {
                                "@type": "Question",
                                "name": t("faq.q4"),
                                "acceptedAnswer": {
                                    "@type": "Answer",
                                    "text": t("faq.a4")
                                }
                            },
                            {
                                "@type": "Question",
                                "name": t("faq.q5"),
                                "acceptedAnswer": {
                                    "@type": "Answer",
                                    "text": t("faq.a5")
                                }
                            }
                        ]
                    }
                </script>
            </div>
        </section>

        {/* REVIEWS SECTION */}
        <section
            id="reviews"
            class="py-24 bg-[#5B3A29] relative overflow-hidden"
        >
            <div
                class="absolute inset-0 opacity-20 bg-[url('https://www.transparenttextures.com/patterns/dark-wood.png')]"
            >
            </div>
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="text-center mb-16">
                    <h2
                        class="text-4xl sm:text-5xl font-serif font-bold text-white mb-6"
                    >
                        {t("reviews.title")}
                        <span class="text-cognac">{t("reviews.title_accent")}</span>
                    </h2>
                    <p class="text-stone-300 text-lg italic max-w-2xl mx-auto">
                        {t("reviews.subtitle")}
                    </p>
                    <div class="w-24 h-1.5 bg-cognac mx-auto rounded-full mt-6"></div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <!-- Review 1 -->
                    <div class="bg-white/10 backdrop-blur-sm p-8 rounded-[2rem] border border-white/10 hover:bg-white/15 transition-all duration-500">
                        <div class="flex gap-1 mb-4">
                            {Array.from({ length: parseInt(t("reviews.item1.rating")) }).map(() => (
                                <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                </svg>
                            ))}
                        </div>
                        <p class="text-stone-200 italic mb-6 leading-relaxed">
                            "{t("reviews.item1.text")}"
                        </p>
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-cognac/20 flex items-center justify-center text-cognac font-bold">
                                {t("reviews.item1.author").charAt(0)}
                            </div>
                            <span class="text-white font-bold">{t("reviews.item1.author")}</span>
                        </div>
                    </div>

                    <!-- Review 2 -->
                    <div class="bg-white/10 backdrop-blur-sm p-8 rounded-[2rem] border border-white/10 hover:bg-white/15 transition-all duration-500">
                        <div class="flex gap-1 mb-4">
                            {Array.from({ length: parseInt(t("reviews.item2.rating")) }).map(() => (
                                <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                </svg>
                            ))}
                        </div>
                        <p class="text-stone-200 italic mb-6 leading-relaxed">
                            "{t("reviews.item2.text")}"
                        </p>
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-cognac/20 flex items-center justify-center text-cognac font-bold">
                                {t("reviews.item2.author").charAt(0)}
                            </div>
                            <span class="text-white font-bold">{t("reviews.item2.author")}</span>
                        </div>
                    </div>

                    <!-- Review 3 -->
                    <div class="bg-white/10 backdrop-blur-sm p-8 rounded-[2rem] border border-white/10 hover:bg-white/15 transition-all duration-500">
                        <div class="flex gap-1 mb-4">
                            {Array.from({ length: parseInt(t("reviews.item3.rating")) }).map(() => (
                                <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                </svg>
                            ))}
                        </div>
                        <p class="text-stone-200 italic mb-6 leading-relaxed">
                            "{t("reviews.item3.text")}"
                        </p>
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-cognac/20 flex items-center justify-center text-cognac font-bold">
                                {t("reviews.item3.author").charAt(0)}
                            </div>
                            <span class="text-white font-bold">{t("reviews.item3.author")}</span>
                        </div>
                    </div>
                </div>

                {/* Review Structured Data */}
                <script type="application/ld+json" is:inline>
                    {
                        "@context": "https://schema.org",
                        "@type": "LocalBusiness",
                        "name": "ParchetMaster",
                        "aggregateRating": {
                            "@type": "AggregateRating",
                            "ratingValue": "5.0",
                            "reviewCount": "3",
                            "bestRating": "5",
                            "worstRating": "1"
                        },
                        "review": [
                            {
                                "@type": "Review",
                                "reviewRating": {
                                    "@type": "Rating",
                                    "ratingValue": t("reviews.item1.rating"),
                                    "bestRating": "5"
                                },
                                "author": {
                                    "@type": "Person",
                                    "name": t("reviews.item1.author")
                                },
                                "reviewBody": t("reviews.item1.text")
                            },
                            {
                                "@type": "Review",
                                "reviewRating": {
                                    "@type": "Rating",
                                    "ratingValue": t("reviews.item2.rating"),
                                    "bestRating": "5"
                                },
                                "author": {
                                    "@type": "Person",
                                    "name": t("reviews.item2.author")
                                },
                                "reviewBody": t("reviews.item2.text")
                            },
                            {
                                "@type": "Review",
                                "reviewRating": {
                                    "@type": "Rating",
                                    "ratingValue": t("reviews.item3.rating"),
                                    "bestRating": "5"
                                },
                                "author": {
                                    "@type": "Person",
                                    "name": t("reviews.item3.author")
                                },
                                "reviewBody": t("reviews.item3.text")
                            }
                        ]
                    }
                </script>
            </div>
        </section>


        {/* CONTACTS SECTION */}
        <section id="contacts" class="py-24 bg-white relative overflow-hidden">
            <div
                class="absolute inset-0 opacity-40 bg-[url('https://www.transparenttextures.com/patterns/pinstriped-suit.png')]"
            >
            </div>
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div
                    class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center"
                >
                    <div>
                        <h2
                            class="text-4xl sm:text-5xl font-serif font-bold text-stone-900 mb-8 uppercase tracking-tight"
                        >
                            {t("contacts.title")}
                            <span class="text-cognac"
                                >{t("contacts.title_accent")}</span
                            >
                        </h2>
                        <p class="text-xl text-stone-600 mb-12 leading-relaxed">
                            {t("contacts.subtitle")}
                            <br />
                            <span class="text-walnut font-medium"
                                >{t("contacts.subtitle_accent")}</span
                            >
                        </p>

                        <div class="space-y-8">
                            <div class="flex items-start gap-6 group">
                                <div
                                    class="bg-cognac/10 p-4 rounded-2xl text-cognac group-hover:bg-cognac group-hover:text-white transition-all duration-500 shadow-sm border border-cognac/5"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-8 w-8"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="1.5"
                                            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
