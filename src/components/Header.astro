---
import { useTranslations } from "../i18n/ui";

const { lang = "ru" } = Astro.props;
const t = useTranslations(lang);
---

<header class="bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <div class="flex-shrink-0 flex items-center">
        <a
          href={lang === "ro" ? "/ro" : "/"}
          class="font-bold text-xl text-cognac"
        >
          ParchetMaster
        </a>
      </div>
      <div class="hidden sm:ml-6 sm:flex sm:space-x-8">
        <a
          href="#services"
          class="text-gray-900 hover:text-cognac px-3 py-2 rounded-md text-sm font-medium"
        >
          {t("nav.services")}
        </a>
        <a
          href="#gallery"
          class="text-gray-900 hover:text-cognac px-3 py-2 rounded-md text-sm font-medium"
        >
          {t("nav.gallery")}
        </a>
        <a
          href="#calculator"
          class="text-gray-900 hover:text-cognac px-3 py-2 rounded-md text-sm font-medium"
        >
          {t("nav.calculator")}
        </a>
        <a
          href="#contacts"
          class="text-gray-900 hover:text-cognac px-3 py-2 rounded-md text-sm font-medium"
        >
          {t("nav.contacts")}
        </a>
      </div>
      <div class="flex items-center space-x-3 sm:space-x-4">
        <a
          href="#calculator"
          class="hidden md:block border-2 border-cognac text-cognac px-4 py-2 rounded-lg text-sm font-bold hover:bg-cognac/10 transition"
        >
          {t("header.request_cta")}
        </a>
        <a
          href="tel:+37360588967"
          class="bg-cognac text-white px-4 py-2 rounded-lg text-sm font-bold hover:brightness-110 transition"
        >
          {t("header.phone_cta")}
        </a>
        <div class="flex space-x-1 text-sm font-medium">
          <a
            href="/"
            class={lang === "ru"
              ? "text-cognac"
              : "text-gray-500 hover:text-gray-900"}>RU</a
          >
          <span class="text-gray-300">|</span>
          <a
            href="/ro"
            class={lang === "ro"
              ? "text-cognac"
              : "text-gray-500 hover:text-gray-900"}>RO</a
          >
        </div>
      </div>
    </div>
  </div>
</header>
