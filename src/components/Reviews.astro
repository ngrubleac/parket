---
import { useTranslations } from "../i18n/ui";

interface Props {
    lang: "ru" | "ro";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const reviews = ["item1", "item2", "item3"];
---

<section id="reviews" class="py-24 bg-[#5B3A29] relative overflow-hidden">
    <div
        class="absolute inset-0 opacity-20 bg-[url('https://www.transparenttextures.com/patterns/dark-wood.png')]"
    >
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center mb-16">
            <h2
                class="text-4xl sm:text-5xl font-serif font-bold text-white mb-6"
            >
                {t("reviews.title")}
                <span class="text-cognac">{t("reviews.title_accent")}</span>
            </h2>
            <p class="text-stone-300 text-lg italic max-w-2xl mx-auto">
                {t("reviews.subtitle")}
            </p>
            <div class="w-24 h-1.5 bg-cognac mx-auto rounded-full mt-6"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {
                reviews.map((item) => (
                    <div class="bg-white/10 backdrop-blur-sm p-8 rounded-[2rem] border border-white/10 hover:bg-white/15 transition-all duration-500">
                        <div class="flex gap-1 mb-4">
                            {Array.from({ length: 5 }).map(() => (
                                <svg
                                    class="w-5 h-5 text-yellow-400 fill-current"
                                    viewBox="0 0 20 20"
                                >
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                </svg>
                            ))}
                        </div>
                        <p class="text-stone-200 italic mb-6 leading-relaxed">
                            "{t(`reviews.${item}.text` as any)}"
                        </p>
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-cognac/20 flex items-center justify-center text-cognac font-bold">
                                {t(`reviews.${item}.author` as any).charAt(0)}
                            </div>
                            <span class="text-white font-bold">
                                {t(`reviews.${item}.author` as any)}
                            </span>
                        </div>
                    </div>
                ))
            }
        </div>

        {/* Review Structured Data */}
        <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "LocalBusiness",
                name: "ParchetMaster",
                aggregateRating: {
                    "@type": "AggregateRating",
                    ratingValue: "5.0",
                    reviewCount: reviews.length.toString(),
                    bestRating: "5",
                    worstRating: "1",
                },
                review: reviews.map((item) => ({
                    "@type": "Review",
                    reviewRating: {
                        "@type": "Rating",
                        ratingValue: "5",
                        bestRating: "5",
                    },
                    author: {
                        "@type": "Person",
                        name: t(`reviews.${item}.author` as any),
                    },
                    reviewBody: t(`reviews.${item}.text` as any),
                })),
            })}
        />
    </div>
</section>
