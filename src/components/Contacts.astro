---
import { useTranslations } from "../i18n/ui";
import { PHONE_NUMBER, WHATSAPP_LINK, VIBER_LINK } from "../config";

interface Props {
    lang: "ru" | "ro";
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contacts" class="py-24 bg-white relative overflow-hidden">
    <div
        class="absolute inset-0 opacity-40 bg-[url('https://www.transparenttextures.com/patterns/pinstriped-suit.png')]"
    >
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
            <div>
                <h2
                    class="text-4xl sm:text-5xl font-serif font-bold text-stone-900 mb-8 uppercase tracking-tight"
                >
                    {t("contacts.title")}
                    <span class="text-cognac">{t("contacts.title_accent")}</span
                    >
                </h2>
                <p class="text-xl text-stone-600 mb-12 leading-relaxed">
                    {t("contacts.subtitle")}
                    <br />
                    <span class="text-walnut font-medium"
                        >{t("contacts.subtitle_accent")}</span
                    >
                </p>

                <div class="space-y-8">
                    <div class="flex items-start gap-6 group">
                        <div
                            class="bg-cognac/10 p-4 rounded-2xl text-cognac group-hover:bg-cognac group-hover:text-white transition-all duration-500 shadow-sm border border-cognac/5"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-8 w-8"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                ></path>
                            </svg>
                        </div>
                        <div>
                            <h3
                                class="font-serif font-bold text-stone-900 text-xl mb-1"
                            >
                                {t("contacts.phone")}
                            </h3>
                            <a
                                href={`tel:${PHONE_NUMBER}`}
                                class="text-cognac font-bold text-2xl hover:text-espresso transition-colors"
                                >{PHONE_NUMBER}</a
                            >
                        </div>
                    </div>

                    <div class="flex items-start gap-6 group">
                        <div
                            class="bg-cognac/10 p-4 rounded-2xl text-cognac group-hover:bg-cognac group-hover:text-white transition-all duration-500 shadow-sm border border-cognac/5"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-8 w-8"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                ></path>
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                        </div>
                        <div>
                            <h3
                                class="font-serif font-bold text-stone-900 text-xl mb-1"
                            >
                                {t("contacts.location")}
                            </h3>
                            <p class="text-stone-600 text-lg italic">
                                {t("contacts.location_val")}
                            </p>
                        </div>
                    </div>

                    <div class="flex items-start gap-6 group">
                        <div
                            class="bg-cognac/10 p-4 rounded-2xl text-cognac group-hover:bg-cognac group-hover:text-white transition-all duration-500 shadow-sm border border-cognac/5"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-8 w-8"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path>
                            </svg>
                        </div>
                        <div>
                            <h3
                                class="font-serif font-bold text-stone-900 text-xl mb-1"
                            >
                                {t("contacts.hours")}
                            </h3>
                            <p class="text-stone-600 text-lg italic">
                                {t("contacts.hours_val")}
                            </p>
                        </div>
                    </div>
                </div>

                <div class="mt-12 flex flex-wrap gap-4">
                    <a
                        href={WHATSAPP_LINK}
                        class="bg-[#25D366] text-white px-8 py-4 rounded-2xl font-bold hover:brightness-110 transition shadow-lg flex items-center gap-3 active:scale-95"
                    >
                        <span class="text-xl">WhatsApp</span>
                    </a>
                    <a
                        href={VIBER_LINK}
                        class="bg-[#7360F2] text-white px-8 py-4 rounded-2xl font-bold hover:brightness-110 transition shadow-lg flex items-center gap-3 active:scale-95"
                    >
                        <span class="text-xl">Viber</span>
                    </a>
                </div>
            </div>

            <div
                class="h-[500px] rounded-[2.5rem] overflow-hidden shadow-2xl border-4 border-parchment relative group"
            >
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d174023.7380922!2d28.8504!3d47.0107!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x40c97c3628b769a1%3A0x23e247b099a4d315!2zQ2hpyJlpbsSDdSwgTW9sZG92YQ!5e0!3m2!1sen!2s!4v1644400000000!5m2!1sen!2s"
                    width="100%"
                    height="100%"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    class="grayscale contrast-[1.2] transition-all duration-1000 group-hover:grayscale-0 group-hover:scale-105"
                ></iframe>
                <div
                    class="absolute inset-0 pointer-events-none border-[1rem] border-espresso/5 shadow-inner"
                >
                </div>
            </div>
        </div>
    </div>
</section>
